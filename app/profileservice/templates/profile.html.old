{% extends "base.html" %}

{% block content %}
<div class="container mt-4">
    <div class="card">
        <div class="card-body">
            <h2 class="card-title">{{ profile.full_name }}</h2>
            <p><strong>Bio:</strong> {{ profile.bio or "No bio available." }}</p>
            <p><strong>Location:</strong> {{ profile.location or "Not specified." }}</p>
            <p><strong>Skills:</strong> {{ profile.skills or "No skills listed." }}</p>
            <p><strong>Experience:</strong></p>
            <p>{{ profile.experience or "No experience details." }}</p>
            <a href="{{ url_for('profileservice.edit_profile') }}" class="btn btn-primary">Edit Profile</a>
        </div>
    </div>
</div>
{% endblock %}
